generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLAYER
  CLUB_OWNER
  CLUB_ADMIN
  APP_ADMIN
}

enum SkillLevel {
  beginner
  intermediate
  advanced
  professional
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  PENDING
}

model User {
  id                 String    @id @default(uuid())
  firebaseUid        String?   @unique
  name               String
  email              String    @unique
  passwordHash       String?
  phone              String?   @unique
  role               Role      @default(PLAYER)
  skillLevel         SkillLevel @default(beginner)
  skillRating        Float     @default(3.0)
  bio                String?
  avatarUrl          String?
  preferredArea      String?
  city               String    @default("Karachi")
  dominantHand       String    @default("right")
  preferredPosition  String    @default("both")
  playingStyle       String    @default("all-round")
  availability       String[]  @default([])
  maxTravelKm        Int       @default(20)
  preferredMode      String    @default("both")
  locationLat        Float?
  locationLng        Float?
  matchmakingEnabled Boolean   @default(true)
  profileComplete    Boolean   @default(false)
  isVerified         Boolean   @default(false)
  totalWins          Int       @default(0)
  totalLosses        Int       @default(0)
  winRate            Float     @default(0)
  recentForm         String[]  @default([])
  currentStreak      Int       @default(0)
  pointsScored       Int       @default(0)
  pointsConceded     Int       @default(0)
  skillRatingHistory Json      @default("[]")
  lastActive         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  bookings            Booking[]
  listings            Listing[]
  sentRequests        MatchRequest[] @relation("SentRequests")
  receivedRequests    MatchRequest[] @relation("ReceivedRequests")
  posts               Post[]
  sentMessages        Message[]      @relation("SentMessages")
  notifications       Notification[]
  courtReviews        Review[]
  savedListings       SavedListing[]
  clubCourts          Court[]         @relation("ClubOwner")
  reviewsGiven        PlayerReview[]  @relation("ReviewsGiven")
  reviewsReceived     PlayerReview[]  @relation("ReviewsReceived")
  club                Club?           @relation("ClubOperator")
  refreshTokens       RefreshToken[]
  createdMatches      Match[]        @relation("MatchCreator")
  player1Matches      Match[]        @relation("Player1")
  player2Matches      Match[]        @relation("Player2")
  organizedTournaments Tournament[]  @relation("TournamentOrganizer")
  postLikes           PostLike[]
  replies             Reply[]        @relation("UserReplies")
  clubApplications    ClubApplication[]
  otpVerification     OtpVerification?

  @@map("users")
}

model Court {
  id            String    @id @default(uuid())
  name          String
  clubName      String
  address       String
  area          String
  city          String    @default("Karachi")
  lat           Float
  lng           Float
  surface       String
  amenities     String[]
  pricePerHour  Int
  description   String?
  isActive      Boolean   @default(true)
  ownerId       String
  owner         User      @relation("ClubOwner", fields: [ownerId], references: [id])
  images        CourtImage[]
  bookings      Booking[]
  reviews       Review[]
  availability  Availability[]
  matches       Match[]
  tournaments   Tournament[]
  createdAt     DateTime  @default(now())

  @@map("courts")
}

model CourtImage {
  id        String  @id @default(uuid())
  courtId   String
  court     Court   @relation(fields: [courtId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)

  @@map("court_images")
}

model Availability {
  id        String   @id @default(uuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id], onDelete: Cascade)
  date      String
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)

  @@unique([courtId, date, startTime])
  @@map("availability")
}

model Booking {
  id            String        @id @default(uuid())
  bookingRef    String        @unique @default(cuid())
  playerId      String
  player        User          @relation(fields: [playerId], references: [id])
  courtId       String
  court         Court         @relation(fields: [courtId], references: [id])
  date          String
  startTime     String
  duration      Int
  totalAmount   Int
  paymentMethod String        @default("cash")
  status        BookingStatus @default(CONFIRMED)
  reviewSent    Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@map("bookings")
}

model Match {
  id          String   @id @default(uuid())
  mode        String   @default("singles")
  player1Id   String
  player1     User     @relation("Player1", fields: [player1Id], references: [id])
  player2Id   String?
  player2     User?    @relation("Player2", fields: [player2Id], references: [id])
  team1       String[]
  team2       String[]
  score       Json     @default("{}")
  courtId     String?
  court       Court?   @relation(fields: [courtId], references: [id])
  date        DateTime @default(now())
  status      String   @default("completed")
  createdById String
  createdBy   User     @relation("MatchCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  playerReviews PlayerReview[]

  @@map("matches")
}

model MatchRequest {
  id          String             @id @default(uuid())
  senderId    String
  sender      User               @relation("SentRequests", fields: [senderId], references: [id])
  receiverId  String
  receiver    User               @relation("ReceivedRequests", fields: [receiverId], references: [id])
  message     String?
  status      String             @default("pending")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@map("match_requests")
}

model Listing {
  id            String           @id @default(uuid())
  title         String
  category      String
  condition     String
  price         Int?
  openToTrade   Boolean          @default(false)
  description   String
  location      String
  views         Int              @default(0)
  isActive      Boolean          @default(true)
  sellerId      String
  seller        User             @relation(fields: [sellerId], references: [id])
  images        ListingImage[]
  savedBy       SavedListing[]
  offers        Offer[]
  createdAt     DateTime         @default(now())
  expiresAt     DateTime

  @@map("listings")
}

model ListingImage {
  id        String  @id @default(uuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)

  @@map("listing_images")
}

model SavedListing {
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  createdAt DateTime @default(now())

  @@id([userId, listingId])
  @@map("saved_listings")
}

model Offer {
  id        String   @id @default(uuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id])
  buyerId   String
  price     Int
  message   String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@map("offers")
}

model Post {
  id        String   @id @default(uuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  type      String
  title     String?
  content   String
  category  String?
  coverUrl  String?
  likes     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  replies   Reply[]
  postLikes PostLike[]

  @@map("posts")
}

model Reply {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation("UserReplies", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  likes     Int      @default(0)
  createdAt DateTime @default(now())

  parentId  String?
  parent    Reply?   @relation("ReplyReplies", fields: [parentId], references: [id])
  children  Reply[]  @relation("ReplyReplies")

  @@map("replies")
}

model PlayerReview {
  id            String   @id @default(uuid())
  matchId       String?
  match         Match?   @relation(fields: [matchId], references: [id])
  reviewerId    String
  reviewer      User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  subjectId     String
  subject       User     @relation("ReviewsReceived", fields: [subjectId], references: [id])
  sportsmanship Int      @default(3)
  punctuality   Int      @default(3)
  skillDisplay  Int      @default(3)
  communication Int      @default(3)
  teamwork      Int      @default(3)
  overallRating Float    @default(3.0)
  tags          String[]
  comment       String?
  createdAt     DateTime @default(now())

  @@unique([reviewerId, subjectId, matchId])
  @@map("player_reviews")
}

model Club {
  id             String   @id @default(uuid())
  ownerId        String   @unique
  owner          User     @relation("ClubOperator", fields: [ownerId], references: [id])
  name           String
  description    String?
  logo           String?
  coverImage     String?
  address        String
  area           String
  city           String   @default("Karachi")
  contactPhone   String?
  contactEmail   String?
  website        String?
  amenities      String[]
  operatingHours Json     @default("{}")
  isApproved     Boolean  @default(false)
  isActive       Boolean  @default(true)
  totalCourts    Int      @default(0)
  totalBookings  Int      @default(0)
  rating         Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("clubs")
}

model Review {
  id        String   @id @default(uuid())
  courtId   String
  court     Court    @relation(fields: [courtId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@map("reviews")
}

model Conversation {
  id           String    @id @default(uuid())
  participant1 String
  participant2 String
  messages     Message[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([participant1, participant2])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@map("messages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@map("notifications")
}

model OtpCode {
  id        String   @id @default(uuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("otp_codes")
}

model OtpVerification {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hash       String   
  expiresAt  DateTime
  attempts   Int      @default(0)
  createdAt  DateTime @default(now())

  @@map("otp_verifications")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model Tournament {
  id                   String   @id @default(uuid())
  name                 String
  description          String
  city                 String   @default("Karachi")
  courtId              String?
  court                Court?   @relation(fields: [courtId], references: [id])
  startDate            DateTime
  endDate              DateTime
  registrationDeadline DateTime
  format               String   @default("knockout")
  skillLevel           String   @default("open")
  maxParticipants      Int      @default(16)
  entryFee             Int      @default(0)
  prizePool            Int      @default(0)
  participants         String[]
  bracket              Json?
  status               String   @default("upcoming")
  organizerId          String
  organizer            User     @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  createdAt            DateTime @default(now())

  @@map("tournaments")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@map("post_likes")
}

model ClubApplication {
  id               String    @id @default(uuid())
  ownerId          String
  owner            User      @relation(fields: [ownerId], references: [id])
  
  clubName         String
  businessType     String
  city             String
  address          String
  numberOfCourts   Int
  surfaces         String[]
  facilities       String[]
  operatingHours   Json
  
  weekdayPrice     Int
  weekendPrice     Int
  minDuration      Int
  maxAdvanceDays   Int
  cancellationPolicy String
  
  photos           String[]
  businessDocument String?
  
  ownerCnic        String
  ownerPhone       String
  
  status           ApplicationStatus @default(PENDING)
  rejectionReason  String?
  reviewedAt       DateTime?
  
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("club_applications")
}
